/target
# Worktrees a fleet creates for parallel beads. `wt/` is the house location, so
# it is ignored here rather than in every developer's global config.
/wt

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the files below, which are history or graph and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl
!.pact/plan.json
